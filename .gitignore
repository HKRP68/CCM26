# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Environment / secrets
.env

# SQLite databases
*.db
*.sqlite3

# Logs
logs/
*.log

# Runtime card-template state (admin-saved; committing it shadows pinned state)
data/card_templates/state.json

# Backup written by migrate_clear_card_file_ids.py
card_file_id_backup_*.json

# Source-archive backups are not used at runtime and bloat the Railway snapshot
*.zip
