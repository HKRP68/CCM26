BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=sqlite:///cricket_bot.db
LOG_LEVEL=INFO

# Bot API 10.1 rich messages (native tables, headings, collapsible blocks) on
# the surfaces that render them, currently /pxi and its bench button. Default
# on; every rich send falls back to the old HTML if Telegram refuses it. Set to
# 0 against a self-hosted Bot API server older than 10.1.
RICH_TEXT=1
ADMIN_PASSWORD=changeme123
# Separate password for revealing encrypted audit-log IP addresses.
AUDIT_LOG_IP_PASSWORD=change-this-ip-reveal-password
ADMIN_PORT=5000

# Persistent storage for uploaded player card images and activity archives.
# Use a private Telegram channel and add the bot as an admin with permission
# to post messages. Telegram channel IDs usually look like -1001234567890.
STORAGE_CHAT_ID=-1001234567890

# Public https base URL of the web service (the Flask app in admin.py).
# Required for the Crickidex Arena Mini App: the "Play Match" button opens
# <WEBAPP_URL host>/cricket?match_id=...&chat_id=... and the Mini App polls
# <host>/api/match. Must be https for Telegram Web App buttons.
WEBAPP_URL=https://your-app-host.example.com
# Used with MINIAPP_NAME to build group deep links
# (startapp=cricket_<matchId>_<chatId>) when a Web App keyboard button isn't
# allowed (i.e. in group chats).
BOT_USERNAME=your_bot_username
# Required for Group Mini App links: the configured Mini App short name
# (t.me/<bot>/<MINIAPP_NAME>). Do not leave this blank: a bot-only deep link can
# open the bot DM instead of the Mini App.
MINIAPP_NAME=your_miniapp_short_name

# Optional: public invite link to your official community group. Shown to
# players who are blocked because they're already in a match ("stuck in a
# match? join the official group and report it there"). Leave blank to show
# the guidance without a clickable link.
OFFICIAL_GROUP_LINK=

# ── Rewarded ads (Mini App spins / daily claim / free packs) ────────────────
# Adsgram block id from partner.adsgram.ai. Leave blank for mock mode (dev):
# ads are simulated and every reward stays claimable.
# Reward URL to configure in the Adsgram ad unit:
#   <WEBAPP_URL>/api/ads/reward?userid=[userId]
ADSGRAM_BLOCK_ID=

# Dedicated Telegram channel for the /catch CRIC wallet snapshot.
# Add the bot as an admin with permission to post and pin messages.
CATCH_STORAGE_CHAT_ID=-1001234567890
CATCH_STARTING_CRIC=1000

# ── Challenge Draft (/cdraft) ──────────────────────────────────────────────
# All optional. The two ratings bound the BAND every slot draws its own target
# from at random — not a ladder, so no slot is pinned to either end.
# NOTE: the rating band, the pair spread and the allowed card editions are
# normally set on the admin website (Match Gameplay → Challenge Draft pool) or
# with /cdraftset, and those stored settings WIN over these. What is here is
# only the fallback for an install where nothing has been set.
CDRAFT_RATING_TOP=88
CDRAFT_RATING_BOTTOM=78
# How far apart the two cards offered in one slot may be on OVR. Keep it small:
# this is what stops either captain being handed the better card.
CDRAFT_PAIR_SPREAD=1
# Seconds a captain has per pick before the bot takes the stronger card for
# them, and how many lapsed picks in a row end the draft.
CDRAFT_PICK_SECONDS=60
CDRAFT_MAX_AUTO_PICKS=3
