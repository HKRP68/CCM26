BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=sqlite:///cricket_bot.db
LOG_LEVEL=INFO
ADMIN_PASSWORD=changeme123
# Separate password for revealing encrypted audit-log IP addresses.
AUDIT_LOG_IP_PASSWORD=change-this-ip-reveal-password
ADMIN_PORT=5000

# Persistent storage for uploaded player card images and activity archives.
# Use a private Telegram channel and add the bot as an admin with permission
# to post messages. Telegram channel IDs usually look like -1001234567890.
STORAGE_CHAT_ID=-1001234567890

# Public https base URL of the web service (the Flask app in admin.py).
# Required for the Crickidex Arena Mini App: the "Play Match" button opens
# <WEBAPP_URL host>/cricket?match_id=...&chat_id=... and the Mini App polls
# <host>/api/match. Must be https for Telegram Web App buttons.
WEBAPP_URL=https://your-app-host.example.com
# Used to build group deep links (startapp=cricket_<matchId>_<chatId>) when a
# Web App keyboard button isn't allowed (i.e. in group chats).
BOT_USERNAME=your_bot_username
# Optional: the configured Mini App short name (t.me/<bot>/<MINIAPP_NAME>).
MINIAPP_NAME=

# Optional: public invite link to your official community group. Shown to
# players who are blocked because they're already in a match ("stuck in a
# match? join the official group and report it there"). Leave blank to show
# the guidance without a clickable link.
OFFICIAL_GROUP_LINK=

# ── Rewarded ads (Mini App spins / daily claim / free packs) ────────────────
# Adsgram block id from partner.adsgram.ai. Leave blank for mock mode (dev):
# ads are simulated and every reward stays claimable.
# Reward URL to configure in the Adsgram ad unit:
#   <WEBAPP_URL>/api/ads/reward?userid=[userId]
ADSGRAM_BLOCK_ID=

# Dedicated Telegram channel for the /catch CRIC wallet snapshot.
# Add the bot as an admin with permission to post and pin messages.
CATCH_STORAGE_CHAT_ID=-1001234567890
CATCH_STARTING_CRIC=1000
