BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=sqlite:///cricket_bot.db
LOG_LEVEL=INFO

# Bot API 10.1 rich messages (native tables, headings, collapsible blocks) on
# the surfaces that render them, currently /pxi and its bench button. Default
# on; every rich send falls back to the old HTML if Telegram refuses it. Set to
# 0 against a self-hosted Bot API server older than 10.1.
RICH_TEXT=1
ADMIN_PASSWORD=changeme123
ADMIN_PORT=5000
# Explicit global identities; use the same IDs on the bot and website services.
# A user may also hold auction and franchise roles at the same time.
BOT_ADMIN_IDS=
OWNER_IDS=

# Persistent storage for uploaded player card images and activity archives.
# Use a private Telegram channel and add the bot as an admin with permission
# to post messages. Telegram channel IDs usually look like -1001234567890.
STORAGE_CHAT_ID=-1001234567890

# Public https base URL of the web service (the Flask app in admin.py).
# Required for the Crickidex Arena Mini App: the "Play Match" button opens
# <WEBAPP_URL host>/cricket?match_id=...&chat_id=... and the Mini App polls
# <host>/api/match. Must be https for Telegram Web App buttons.
WEBAPP_URL=https://your-app-host.example.com
# Used with MINIAPP_NAME to build group deep links
# (startapp=cricket_<matchId>_<chatId>) when a Web App keyboard button isn't
# allowed (i.e. in group chats).
BOT_USERNAME=your_bot_username
# Required for Group Mini App links: the configured Mini App short name
# (t.me/<bot>/<MINIAPP_NAME>). Do not leave this blank: a bot-only deep link can
# open the bot DM instead of the Mini App.
MINIAPP_NAME=your_miniapp_short_name

# ── Standalone Franchise Auction website (website.py) ──────────────────────
# Shares BOT_TOKEN, BOT_USERNAME and DATABASE_URL with the existing bot. Keep
# the bot worker running: it advances auction clocks and sends announcements.
# Use a shared PostgreSQL database for separate web/bot hosts, not two SQLite
# files. See docs/franchise-website.md for deployment and BotFather /setdomain.
# Render can create the separate Python Web Service from render.franchise.yaml.
# It reuses the existing database; the existing bot start command stays intact.
# A stable, independent random secret of at least 32 characters is required
# for browser login; store its real value in the hosting provider's secrets.
WEBSITE_SECRET=
# Keep true on the public HTTPS deployment. Set false only for local HTTP QA.
WEBSITE_HTTPS=true
WEBSITE_PORT=5001
# Optional: when set to a full HTTPS URL, Telegram auction buttons open this
# website. Leave empty to omit the website button.
FRANCHISE_WEBSITE_URL=
# Maximum live update streams per web worker. Keep below the worker's thread
# count so bids and login requests have capacity. Extra clients auto-refresh.
# The Render Blueprint uses 32 threads and at most 12 streams per worker.
AUCTION_STREAM_MAX_CLIENTS=12

# Pause between live final-over chase deliveries (seconds, 0–10).
# Each delivery is saved and shown separately; the previous ball is removed.
FINAL_OVER_BALL_DELAY_SECONDS=2.5

# Optional: public invite link to your official community group. Shown to
# players who are blocked because they're already in a match ("stuck in a
# match? join the official group and report it there"). Leave blank to show
# the guidance without a clickable link.
OFFICIAL_GROUP_LINK=

# ── Rewarded ads (Mini App spins / daily claim / free packs) ────────────────
# Set the numeric Reward block ID to enable Adsgram SDK completion rewards.
# For optional callbacks, set a URL-safe secret of at least 32 characters and use
# this Reward URL on the Adsgram block:
#   https://<your-app-host>/api/ads/reward?userid=[userId]&secret=YOUR_SECRET
# Restrict access to callback URL logs or redact query strings in your proxy.
# Set ADSGRAM_REQUIRE_POSTBACK=1 to accept only verified callbacks.
ADSGRAM_BLOCK_ID=
ADSGRAM_POSTBACK_SECRET=
ADSGRAM_REQUIRE_POSTBACK=

# Dedicated Telegram channel for the /catch CRIC wallet snapshot.
# Add the bot as an admin with permission to post and pin messages.
CATCH_STORAGE_CHAT_ID=-1001234567890
CATCH_STARTING_CRIC=1000

# ── Challenge Draft (/cdraft) ──────────────────────────────────────────────
# All optional. The two ratings bound the BAND every slot draws its own target
# from at random — not a ladder, so no slot is pinned to either end.
# NOTE: the rating band, the pair spread and the allowed card editions are
# normally set on the admin website (Match Gameplay → Challenge Draft pool) or
# with /cdraftset, and those stored settings WIN over these. What is here is
# only the fallback for an install where nothing has been set.
CDRAFT_RATING_TOP=88
CDRAFT_RATING_BOTTOM=78
# How far apart the two cards offered in one slot may be on OVR. Keep it small:
# this is what stops either captain being handed the better card.
CDRAFT_PAIR_SPREAD=1
# Seconds a captain has per pick before the bot takes the stronger card for
# them, and how many lapsed picks in a row end the draft.
CDRAFT_PICK_SECONDS=60
CDRAFT_MAX_AUTO_PICKS=3

# ── Realism Engine v1 (docs/realism_engine_v1.md) ───────────────────────────
# A data-driven ball-outcome model calibrated to real cricket, wired into
# /cipl, /sim and /letsplay. OFF by default: leaving all of these unset keeps
# the engine CCM26 has always had, delivery for delivery. Player cards,
# ratings, scorecards, commands and database schemas are untouched either way.
#
# Let the realism model decide live outcomes.
SIM_REALISM_ENABLED=0
# Compute the realism distribution alongside the legacy one, record the
# divergence, and keep the LEGACY outcome. Draws no random numbers, so a
# shadow run is bit-identical to a realism-off run from the same seed. If both
# this and SIM_REALISM_ENABLED are set, shadow wins.
SIM_REALISM_SHADOW_MODE=0
# Which data/simulation_reference/<version>/ to read.
SIM_REALISM_REFERENCE_VERSION=v1
# Formats the model may drive. ListA/ODI and Test are deliberately absent:
# their reference data is not validated, so they stay on the legacy engine.
SIM_REALISM_FORMATS=T20,The100
# Realism mode also recalibrates the tactical layer: the batting and bowling
# approaches become priced trade-offs, overlapping pitch/phase/momentum/
# fatigue modifiers stop being applied twice, hidden identity-derived player
# ability is removed, the bot captain reasons in win probability, and the
# result-steering hooks (par-band brake, contest tightening, clutch finale,
# wicket mix-up) switch off. Approach names, pitch types and every control
# stay exactly as they are. See docs/realism_approaches.md; individual pieces
# are switchable in config/realism.json.
#
# Force a competition/era baseline instead of the reference's default
# (ipl_modern). Options in the shipped v1: ipl_2008_2013, ipl_2014_2021,
# ipl_modern. Leave blank for the default.
SIM_REALISM_BASELINE=

# Experimental ODI Approach match entry. Set to 0 to pause new ODI matches.
CMU_ODI_APPROACH_ENABLED=1
