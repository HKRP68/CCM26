# Keep the Docker build context small so Railway's "Taking a snapshot of the
# code" step stays fast. Nothing excluded here is needed to run `python bot.py`.

# Git history (~28 MB)
.git
.gitignore

# Source-archive backups (~26 MB) — not used at runtime
*.zip

# Python caches / virtualenvs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Local env / secrets
.env
.env.*
!.env.example

# Tests & docs (not needed in the runtime image)
tests/
docs/
*.md
# ...but keep data files the app reads at runtime
!data/quests_table.md

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
