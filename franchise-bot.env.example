# Dedicated Franchise Auction bot only. Set real values in the new Render
# service's environment, or in a separate local franchise-bot.env file.
# Create a NEW Telegram bot with @BotFather /newbot.
FRANCHISE_BOT_TOKEN=
# A NEW PostgreSQL database, not the current cricket bot's database.
FRANCHISE_DATABASE_URL=
# Your explicit Telegram user ID(s), comma separated.
FRANCHISE_OWNER_IDS=
# Optional additional global bot administrators, comma separated.
FRANCHISE_ADMIN_IDS=
# Optional; the running bot discovers its username from Telegram.
FRANCHISE_BOT_USERNAME=
# The unrelated solo career minigame is off by default.
FRANCHISE_SOLO_LEAGUE=false
# Render supplies PORT for the /healthz readiness endpoint. For local worker
# mode leave this blank; the bot does not need an HTTP website.
FRANCHISE_HEALTH_PORT=
